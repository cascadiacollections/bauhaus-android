<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).

    DataStore preferences are stored under files/datastore/*.preferences_pb.
    They are device-specific (wallpaper target, scheduling state) and should
    not be restored from cloud backup on a different device. We do allow
    device-to-device transfer so migrating to a new phone preserves settings.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
