<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis="0" is deliberate. The content changes once a day, at a
    moment the app already knows about: the wallpaper worker refreshes the widget
    after a successful set. Letting the launcher poll on its own schedule would be
    a standing service cost that could never surface anything new.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:previewImage="@drawable/ic_launcher_foreground"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
