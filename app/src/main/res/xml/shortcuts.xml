<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher shortcuts (long-press the app icon).

    Both target MainActivity rather than trampoline activities, so the app stays
    a single activity and each shortcut is just an intent action MainActivity
    already knows how to handle.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="set_wallpaper"
        android:enabled="true"
        android:icon="@drawable/ic_tile_bauhaus"
        android:shortcutShortLabel="@string/shortcut_set_wallpaper_short"
        android:shortcutLongLabel="@string/shortcut_set_wallpaper_long">
        <intent
            android:action="com.cascadiacollections.bauhaus.action.SET_TODAY"
            android:targetPackage="com.cascadiacollections.bauhaus"
            android:targetClass="com.cascadiacollections.bauhaus.MainActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="browse_archive"
        android:enabled="true"
        android:icon="@drawable/ic_calendar"
        android:shortcutShortLabel="@string/shortcut_browse_archive_short"
        android:shortcutLongLabel="@string/shortcut_browse_archive_long">
        <intent
            android:action="com.cascadiacollections.bauhaus.action.BROWSE_ARCHIVE"
            android:targetPackage="com.cascadiacollections.bauhaus"
            android:targetClass="com.cascadiacollections.bauhaus.MainActivity" />
    </shortcut>

</shortcuts>
