<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick Settings tile icon. SystemUI tints this with the tile's foreground
    colour, so the paths are a flat solid black silhouette and the drawable
    carries no tint of its own — the same bauhaus composition as the themed
    launcher icon, redrawn on a 24dp grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Circle -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,8m-3.1,0a3.1,3.1 0,1 1,6.2 0a3.1,3.1 0,1 1,-6.2 0" />
    <!-- Triangle -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M8,16.9L12,11.6L16,16.9Z" />
    <!-- Square -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M6.7,11.6h3.5v3.5h-3.5z" />
</vector>
