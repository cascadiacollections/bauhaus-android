<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!--
        Only ever used to report on an update the user asked for by hand. The
        daily job never notifies, and the app degrades to silence rather than
        failing when the permission is denied.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BauhausApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Bauhaus">
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Bauhaus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Launcher shortcuts target this same activity by action, so the
                app keeps its single-activity shape.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Quick Settings tile. Only the system may bind it, which is what
            BIND_QUICK_SETTINGS_TILE enforces; exported="true" is required for
            SystemUI to reach it at all.

            No TOGGLEABLE_TILE meta-data: this tile performs an action rather
            than flipping a persistent setting, so it must not be offered as a
            one-tap toggle in the "active tile" sense.
        -->
        <service
            android:name=".tile.WallpaperTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_bauhaus"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!--
            Home-screen widget. The receiver is exported because the launcher
            must be able to reach it; it accepts only the standard AppWidget
            broadcasts.
        -->
        <receiver
            android:name=".widget.BauhausAppWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bauhaus_widget_info" />
        </receiver>
    </application>

</manifest>
